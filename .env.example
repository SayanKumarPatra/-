# BCA STUDY POINT - Production Environment Variables Template

# 1. Razorpay Payment Gateway Credentials
# Register at https://dashboard.razorpay.com/ and obtain API keys in Settings > API Keys
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID_HERE"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_SECRET_KEY_HERE"
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# 2. Administrator Access Credentials
# Secret key used to authenticate to the Admin Portal (/admin)
ADMIN_SECRET_KEY="bca_admin_secure_2026"

# 3. Server Runtime Port
PORT=3000
NODE_ENV="development"

# 4. Optional Firebase Credentials (if using direct Firebase Admin SDK in addition to local engine)
# FIREBASE_PROJECT_ID="bca-study-point"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk@bca-study-point.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
