rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Products collection: public read, authenticated or admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // Allows real-time admin edits directly from portal
    }

    // Students collection: registration and profile sync
    match /students/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection: creation and student status lookup
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
